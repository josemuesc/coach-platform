# Supabase -> Project Settings -> Database -> Connect -> SESSION pooler (port 5432)
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.rnkayaatdssplqwsleec
DB_PASSWORD=change-me
# At least 32 random bytes, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRATION_MINUTES=480
# At least 32 random bytes: signs the rotating QR code of each class (openssl rand -base64 48). Required to start.
APP_QR_SECRET=change-me-change-me-change-me-change-me

# Public URL of the frontend: invitation links are built as <FRONTEND_URL>/invite/<token>
APP_FRONTEND_URL=http://localhost:5173
# Invitation validity in days
# APP_INVITATIONS_EXPIRY_DAYS=7
# ONLY behind a TRUSTED reverse proxy that rewrites X-Forwarded-For (Railway/Render/your own Nginx), so rate limiting
# sees the real client IP. Never set it when the app is reachable directly: clients could spoof the header and
# bypass the per-IP limits. Leave it unset locally.
# SERVER_FORWARD_HEADERS_STRATEGY=native
# Port (the default 8080 may be taken by another local project)
# SERVER_PORT=8081
